}

// ——— answers sent from the personal page, and unsent drafts ———
var RESPONSE_COLS = ['date', 'kind', 'rater', 'ratee', 'freq', 'data'];
var DRAFT_COLS = ['saved', 'rater', 'key', 'data'];
function responsesSheet_() {
