  if (s === 'keep' || s === 'إبقاء' || s === 'ابقاء' || s === t_('word.keep').toLowerCase()) return 'KEEP'; // i18n-ok: reads both languages
  if (s === 'exclude' || s === 'استبعاد' || s === t_('word.exclude').toLowerCase()) return 'EXCLUDE'; // i18n-ok: reads both languages
