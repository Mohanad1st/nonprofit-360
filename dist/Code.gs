    var sh = sheet_(id); if (!sh) return;
    var want = tabName_(id);
    if (sh.getName() !== want && !book_().getSheetByName(want)) { sh.setName(want); n++; }
    dirSheet_(sh);
  });
  return n;
}
function guideTab_() {
